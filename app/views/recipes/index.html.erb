<div class="container mx-auto px-4 py-6">
  <div class="mb-8">
    <%= link_to plan_trip_path(@trip), class: "text-primary-accent hover:text-primary-accent/80 font-medium flex items-center group mb-4" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 transform group-hover:-translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
      </svg>
      Back to Trip
    <% end %>
    <h1 class="text-3xl font-bold text-text-primary">Recipes</h1>
  </div>

  <% if @recipes.any? %>
    <!-- All Recipes -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <% @recipes.each do |recipe| %>
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition-all duration-300 group">
          <div class="p-5">
            <div class="flex items-start justify-between mb-3">
              <h3 class="font-bold text-gray-900 text-lg leading-tight group-hover:text-primary-accent transition-colors">
                <%= link_to recipe.name, trip_recipe_path(@trip, recipe) %>
              </h3>
              <div class="flex-shrink-0 ml-2">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                  <%= recipe.servings %> ppl
                </span>
              </div>
            </div>

            <% if recipe.description.present? %>
              <p class="text-gray-500 text-sm mb-4 line-clamp-2 h-10"><%= recipe.description %></p>
            <% else %>
              <div class="h-10 mb-4"></div>
            <% end %>

            <div class="flex items-center text-xs text-gray-400 mb-4 space-x-3">
              <span class="flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                <%= recipe.ingredients.count %> ingredients
              </span>
              <% if recipe.meal_plans.any? %>
                <span class="flex items-center text-green-600">
                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                  Planned <%= pluralize(recipe.meal_plans.count, 'time') %>
                </span>
              <% end %>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-gray-50">
              <button onclick="document.getElementById('add-to-plan-modal-<%= recipe.id %>').classList.remove('hidden')"
                      class="text-primary-accent hover:text-primary-accent-dark text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path></svg>
                Add to Plan
              </button>

              <div class="flex space-x-2">
                <%= link_to edit_trip_recipe_path(@trip, recipe), class: "text-gray-400 hover:text-blue-500 p-1" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"></path></svg>
                <% end %>
                <%= link_to trip_recipe_path(@trip, recipe), method: :delete, data: { confirm: "Delete this recipe?" }, class: "text-gray-400 hover:text-red-500 p-1" do %>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Modals outside the grid -->
    <% @recipes.each do |recipe| %>
      <div id="add-to-plan-modal-<%= recipe.id %>" class="hidden fixed inset-0 z-50 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
          <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="document.getElementById('add-to-plan-modal-<%= recipe.id %>').classList.add('hidden')"></div>
          <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
          <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
              <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4">
                Add "<%= recipe.name %>" to Meal Plan
              </h3>
              <%= form_with model: MealPlan.new, url: meal_plans_path, local: true do |f| %>
                <%= f.hidden_field :recipe_id, value: recipe.id %>

                <div class="mb-4">
                  <%= f.label :date, class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= f.date_field :date, value: Date.today, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary-accent focus:ring focus:ring-primary-accent focus:ring-opacity-50" %>
                </div>

                <div class="mb-4">
                  <%= f.label :meal_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= f.select :meal_type, [
                    ["Breakfast", "breakfast"],
                    ["Lunch", "lunch"],
                    ["Dinner", "dinner"],
                    ["Snack", "snack"],
                    ["Miscellaneous", "miscellaneous"],
                    ["Drinks", "drinks"]
                  ], {}, { class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary-accent focus:ring focus:ring-primary-accent focus:ring-opacity-50" } %>
                </div>

                <div class="mb-4">
                  <%= f.label :description, "Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= f.text_area :description, rows: 2, class: "w-full rounded-md border-gray-300 shadow-sm focus:border-primary-accent focus:ring focus:ring-primary-accent focus:ring-opacity-50" %>
                </div>

                <div class="mt-5 sm:mt-6 flex justify-end space-x-3">
                  <button type="button" onclick="document.getElementById('add-to-plan-modal-<%= recipe.id %>').classList.add('hidden')" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-accent">
                    Cancel
                  </button>
                  <%= f.submit "Add to Plan", class: "inline-flex justify-center w-full rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-accent text-base font-medium text-white hover:bg-primary-accent-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-accent sm:text-sm sm:w-auto" %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <!-- Empty State -->
    <div class="text-center py-16">
      <div class="w-24 h-24 bg-primary-accent/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-12 h-12 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"/>
        </svg>
      </div>
      <h2 class="text-2xl font-semibold text-text-primary mb-3">No recipes yet</h2>
      <p class="text-text-primary/70 mb-8 max-w-md mx-auto">Start planning your meals and generate shopping lists for your trip</p>
      <%= link_to "Add Your First Recipe", new_trip_recipe_path(@trip), class: "bg-primary-accent text-white px-8 py-3 rounded-xl font-semibold hover:bg-primary-accent/80 transition-colors shadow-lg transform hover:scale-105" %>
    </div>
  <% end %>
</div>
