<% content_for :title, "Shopping Plan - #{@trip.name}" %>

<div id="shopping_plan_wrapper" class="pb-44 md:pb-28">
  <%= render "plan_content" %>
</div>

<div class="fixed inset-x-0 bottom-24 z-50 px-1 md:bottom-6 md:px-4">
  <div class="relative w-full px-2 py-1">
    <%= form_with scope: :shopping_requirement, url: plans_shopping_manual_requirement_path(trip_id: @trip.id), id: "manual_add_form_element", class: "w-full min-h-[44px]", data: { controller: "food-item-picker", "food-item-picker-target": "form", "food-item-picker-items-value": @food_item_picker_payload.to_json, action: "turbo:submit-end->food-item-picker#afterSubmit" } do |form| %>
      <%= form.hidden_field :food_item_id, data: { "food-item-picker-target": "foodItemId" } %>

      <div id="manual_requirement_error"></div>

      <div data-food-item-picker-target="panel" class="fixed inset-x-2 bottom-40 z-[70] hidden overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl md:absolute md:inset-x-0 md:bottom-full md:mb-2">
        <div class="p-1">
          <div data-food-item-picker-target="emptyState" class="mb-2 px-3 py-4 text-center text-sm font-semibold text-slate-500">
            Start typing to search...
          </div>
          <div data-food-item-picker-target="results" class="mb-2 max-h-48 space-y-1 overflow-y-auto overscroll-contain touch-pan-y" style="-webkit-overflow-scrolling: touch;"></div>
          <div class="relative shrink-0 border-t border-slate-100 bg-slate-50 p-2 text-center text-[0.65rem] font-bold uppercase tracking-wider text-slate-500" data-food-item-picker-target="summary">
            Custom item
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <div class="relative min-w-0 flex-1">
          <%= form.text_field :name, id: "manual_add_name_input", placeholder: "Add item...", class: "w-full rounded-2xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-900 shadow-sm focus:ring-2 focus:ring-blue-500", autocomplete: "off", data: { "food-item-picker-target": "name", action: "input->food-item-picker#search keyup->food-item-picker#search focus->food-item-picker#focus keydown->food-item-picker#handleKeydown" } %>
        </div>

        <%= form.text_field :quantity, id: "manual_add_quantity_input", inputmode: "decimal", enterkeyhint: "done", placeholder: "Qty", class: "w-16 shrink-0 rounded-2xl border border-slate-200 bg-white px-2 py-2.5 text-center text-sm font-semibold text-slate-900 shadow-sm focus:ring-2 focus:ring-blue-500", data: { action: "keydown->food-item-picker#submitFromQuantity keypress->food-item-picker#submitFromQuantity keyup->food-item-picker#submitFromQuantity" } %>
        <%= form.select :unit, options_for_select(%w[kg l pieces g ml], "pieces"), {}, class: "w-24 shrink-0 rounded-2xl border border-slate-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-900 shadow-sm focus:ring-2 focus:ring-blue-500 [&>option]:bg-white", tabindex: -1, data: { "food-item-picker-target": "unit" } %>

        <%= form.hidden_field :category, value: "other", data: { "food-item-picker-target": "category" } %>

        <%= form.button type: "submit", data: { action: "pointerdown->food-item-picker#preventBlur" }, class: "flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-primary-accent text-white shadow-lg hover:bg-accent-red-dark transition-all active:scale-95" do %>
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
