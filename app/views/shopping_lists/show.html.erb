<% content_for :title, "#{@shopping_list.name} - #{@trip.name}" %>

<div class="mx-auto max-w-5xl px-4 py-2 sm:py-3">
  <div class="grid grid-cols-3 gap-3 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
      <div>
        <div class="text-xs uppercase tracking-[0.14em] text-slate-500">Open</div>
        <div class="mt-1 text-2xl font-semibold text-slate-950"><%= @open_assignment_count %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-[0.14em] text-slate-500">Done</div>
        <div class="mt-1 text-2xl font-semibold text-emerald-600"><%= @done_assignment_count %></div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-[0.14em] text-slate-500">Items</div>
        <div class="mt-1 text-2xl font-semibold text-slate-950"><%= @aggregated_assignments.count %></div>
      </div>
  </div>

  <div class="mt-3 flex flex-wrap gap-2">
    <%= link_to "Back to Shopping Plan", plans_shopping_path(trip_id: @trip.id), class: "rounded-full bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200" %>
    <% @trip.shopping_lists.where(archived_at: nil).order(:position, :created_at).each do |list| %>
      <%= link_to list.name, trip_shopping_list_path(@trip, list), class: "rounded-full px-4 py-2 text-sm font-semibold #{list == @shopping_list ? 'bg-slate-900 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:border-slate-300'}" %>
    <% end %>
  </div>

  <% if @aggregated_assignments.any? %>
    <div class="mt-4 space-y-6">
      <% @assignment_groups.each do |category, items| %>
        <section>
          <div class="mb-3 flex items-center justify-between">
            <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-slate-500"><%= category %></h2>
            <span class="text-xs text-slate-400"><%= pluralize(items.count, "item") %></span>
          </div>

          <div class="space-y-3">
            <% items.each do |item| %>
              <article class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm">
                <div class="flex items-start justify-between gap-4">
                  <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                      <h3 class="text-lg font-semibold text-slate-950"><%= item.name %></h3>
                      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700"><%= item.planned_quantity %> <%= item.unit %></span>
                      <% if item.has_comments %>
                        <span class="rounded-full bg-amber-100 px-2.5 py-1 text-xs font-semibold text-amber-800">Comments</span>
                      <% end %>
                    </div>
                    <div class="mt-2 text-sm text-slate-600">
                      <strong class="text-slate-900"><%= item.purchased_quantity %> <%= item.unit %></strong> purchased,
                      <strong class="text-slate-900"><%= item.remaining_quantity %> <%= item.unit %></strong> remaining
                    </div>
                    <% if item.source_labels.any? %>
                      <div class="mt-3 flex flex-wrap gap-2">
                        <% item.source_labels.each do |label| %>
                          <span class="rounded-full bg-violet-50 px-2.5 py-1 text-xs font-medium text-violet-700"><%= label %></span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <div class="text-right text-sm text-slate-500">
                    <div><%= item.assignments.count %> split<%= 's' unless item.assignments.count == 1 %></div>
                  </div>
                </div>

                <details class="mt-4 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
                  <summary class="cursor-pointer text-sm font-semibold text-slate-700">Details</summary>
                  <div class="mt-4 space-y-3">
                    <% item.assignments.each do |assignment| %>
                      <div class="rounded-2xl border border-slate-200 bg-white p-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                          <div>
                            <div class="text-sm font-semibold text-slate-900"><%= assignment.shopping_requirement.name %></div>
                            <div class="text-xs text-slate-500">
                              <%= assignment.shopping_requirement.source_label.presence || assignment.shopping_requirement.source_type.humanize %>
                            </div>
                          </div>
                          <div class="text-sm text-slate-600">
                            <%= assignment.purchased_quantity %> / <%= assignment.planned_quantity %> <%= assignment.unit %>
                          </div>
                        </div>

                        <div class="mt-3 grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto_auto]">
                          <%= form_with url: record_purchase_trip_shopping_list_shopping_list_assignment_path(@trip, @shopping_list, assignment), method: :patch, local: true, class: "flex gap-2" do |form| %>
                            <%= number_field_tag :quantity, assignment.remaining_quantity.positive? ? assignment.remaining_quantity : nil, step: :any, min: 0, placeholder: "Add purchased amount", class: "w-full rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900" %>
                            <%= form.submit "Add", class: "rounded-xl bg-blue-600 px-3 py-2 text-sm font-semibold text-white hover:bg-blue-700" %>
                          <% end %>
                          <%= button_to "Done", mark_complete_trip_shopping_list_shopping_list_assignment_path(@trip, @shopping_list, assignment), method: :patch, class: "rounded-xl bg-emerald-100 px-3 py-2 text-sm font-semibold text-emerald-800 hover:bg-emerald-200" %>
                          <%= button_to "Clear", clear_purchase_trip_shopping_list_shopping_list_assignment_path(@trip, @shopping_list, assignment), method: :patch, class: "rounded-xl bg-slate-200 px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-300" %>
                        </div>

                        <% if assignment.shopping_item_comments.any? %>
                          <div class="mt-3 space-y-2 border-t border-slate-100 pt-3">
                            <% assignment.shopping_item_comments.ordered.each do |comment| %>
                              <div class="rounded-xl bg-amber-50 px-3 py-2 text-sm text-slate-700">
                                <div class="font-medium text-slate-900"><%= comment.user.email_address %></div>
                                <div class="mt-1"><%= comment.body %></div>
                              </div>
                            <% end %>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </details>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="mt-4 rounded-3xl border border-dashed border-slate-300 bg-slate-50 px-6 py-10 text-center text-slate-600">
      <p class="text-base font-semibold text-slate-900">This list is still empty</p>
      <%= link_to "Open Shopping Plan", plans_shopping_path(trip_id: @trip.id), class: "mt-4 inline-flex rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800" %>
    </div>
  <% end %>
</div>
