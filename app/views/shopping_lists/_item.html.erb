<% item_id = "item_#{item.key.parameterize}" %>
<% is_done = item.remaining_quantity <= 0 %>

<article id="<%= item_id %>" class="rounded-3xl border <%= is_done ? 'border-emerald-200 bg-emerald-50/50' : 'border-slate-200 bg-white' %> p-4 shadow-sm transition-all duration-300 animate-slide-up">
  <div class="flex items-start gap-4">
    
    <%# Left Side - Completion Toggle %>
    <div class="flex-shrink-0 pt-0.5">
      <% if is_done %>
        <% if item.assignments.count == 1 %>
          <%= button_to clear_purchase_trip_shopping_list_shopping_list_assignment_path(trip, shopping_list, item.assignments.first), method: :patch, class: "flex h-8 w-8 items-center justify-center rounded-full bg-emerald-500 text-white hover:bg-emerald-600 transition-colors" do %>
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <% end %>
        <% else %>
          <div class="flex h-8 w-8 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          </div>
        <% end %>
      <% else %>
        <% if item.assignments.count == 1 %>
          <%= button_to mark_complete_trip_shopping_list_shopping_list_assignment_path(trip, shopping_list, item.assignments.first), method: :patch, class: "flex h-8 w-8 items-center justify-center rounded-full border-2 border-slate-300 text-transparent hover:border-emerald-500 hover:text-emerald-500 transition-colors bg-white shadow-sm" do %>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
          <% end %>
        <% else %>
          <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-dashed border-slate-300 bg-slate-50"></div>
        <% end %>
      <% end %>
    </div>

    <%# Main Info %>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="text-lg font-semibold <%= is_done ? 'text-slate-500 line-through' : 'text-slate-950' %>"><%= item.name %></h3>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-xs font-medium text-slate-700">
          <%= item.purchased_quantity.positive? ? "#{item.purchased_quantity.to_s.sub(/\.0$/, '')} / " : "" %><%= item.planned_quantity.to_s.sub(/\.0$/, '') %> <%= item.unit %>
        </span>
        <% if item.has_comments %>
          <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-100 text-amber-600 shadow-sm" title="Has comments">
            <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20"><path d="M18 10c0 3.866-3.582 7-8 7a8.841 8.841 0 01-4.083-.98L2 17l1.338-3.123C2.493 12.767 2 11.434 2 10c0-3.866 3.582-7 8-7s8 3.134 8 7zM7 9H5v2h2V9zm8 0h-2v2h2V9zM9 9h2v2H9V9z"/></svg>
          </span>
        <% end %>
      </div>

      <% if item.source_labels.any? && !is_done %>
        <div class="mt-2 flex flex-wrap gap-2">
          <% item.source_labels.each do |label| %>
            <span class="rounded-full bg-violet-50 px-2 py-0.5 text-[0.65rem] font-medium uppercase tracking-wider text-violet-700"><%= label %></span>
          <% end %>
        </div>
      <% end %>
      
      <%# Simplified interaction %>
      <% if !is_done %>
        <div class="mt-3">
          <% if item.assignments.count == 1 %>
            <% assignment = item.assignments.first %>
            <%= form_with url: record_purchase_trip_shopping_list_shopping_list_assignment_path(trip, shopping_list, assignment), method: :patch, class: "flex items-center gap-2 max-w-[200px]" do |form| %>
              <%= number_field_tag :quantity, nil, step: :any, min: 0, placeholder: "Add qty", class: "w-24 rounded-full border border-slate-200 bg-slate-50 px-4 py-1.5 text-sm text-slate-900 focus:bg-white focus:ring-2 focus:ring-slate-400 focus:outline-none transition-shadow", autocomplete: "off" %>
              <%= form.submit "+", class: "rounded-full bg-slate-100 px-4 py-1.5 text-sm font-bold text-slate-600 hover:bg-slate-200 transition-colors" %>
            <% end %>
          <% else %>
            <%# Multiple splits shown inline %>
            <div class="space-y-2 border-t border-slate-100 pt-3 mt-3">
              <div class="text-[0.65rem] font-bold uppercase tracking-wider text-slate-400"><%= item.assignments.count %> sources</div>
              <% item.assignments.each do |assignment| %>
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-slate-50 p-3 shadow-inner">
                  <div class="flex-1 min-w-0">
                    <div class="truncate text-xs font-semibold text-slate-700"><%= assignment.shopping_requirement.source_label.presence || assignment.shopping_requirement.source_type.humanize %></div>
                    <div class="text-[0.65rem] text-slate-500">Need: <%= assignment.remaining_quantity.to_s.sub(/\.0$/, '') %> <%= assignment.unit %></div>
                  </div>
                  <div class="flex gap-2">
                    <% if assignment.remaining_quantity.positive? %>
                      <%= form_with url: mark_complete_trip_shopping_list_shopping_list_assignment_path(trip, shopping_list, assignment), method: :patch, class: "flex" do |f| %>
                        <%= f.button class: "flex h-7 w-7 items-center justify-center rounded-full bg-white shadow-sm border border-slate-200 text-emerald-600 hover:border-emerald-400 hover:bg-emerald-50 transition-colors" do %>
                           <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                        <% end %>
                      <% end %>
                    <% else %>
                      <%= form_with url: clear_purchase_trip_shopping_list_shopping_list_assignment_path(trip, shopping_list, assignment), method: :patch, class: "flex" do |f| %>
                        <%= f.button class: "flex h-7 w-7 items-center justify-center rounded-full bg-slate-200 text-slate-600 hover:bg-slate-300 transition-colors" do %>
                           <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"/></svg>
                        <% end %>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</article>
