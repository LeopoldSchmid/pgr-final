<div id="stats_bar" class="grid grid-cols-3 gap-3 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm animate-fade-in">
    <div>
      <div class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-slate-400">Open</div>
      <div class="mt-1 text-2xl font-semibold <%= open_count.positive? ? 'text-slate-950' : 'text-slate-400' %>"><%= open_count %></div>
    </div>
    <div>
      <div class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-slate-400">Done</div>
      <div class="mt-1 text-2xl font-semibold <%= done_count.positive? ? 'text-emerald-600' : 'text-slate-400' %>"><%= done_count %></div>
    </div>
    <div>
      <div class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-slate-400">Items</div>
      <div class="mt-1 text-2xl font-semibold text-slate-950"><%= items_count %></div>
    </div>
</div>
