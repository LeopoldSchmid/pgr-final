<div class="container mx-auto px-4 pt-2 pb-6" data-controller="modal-animation">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-text-primary">Meal Plan</h1>
    </div>
    <div class="flex space-x-3">
      <%= link_to plans_meals_path(start_date: @start_date - 1.week), class: "p-2 rounded-full hover:bg-gray-100 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <% end %>
      <span class="text-lg font-medium self-center">
        <%= @start_date.strftime("%b %d") %> - <%= @end_date.strftime("%b %d") %>
      </span>
      <%= link_to plans_meals_path(start_date: @start_date + 1.week), class: "p-2 rounded-full hover:bg-gray-100 transition-colors" do %>
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-7 gap-4 mb-8">
    <% (@start_date..@end_date).each do |date| %>
      <div class="flex flex-col space-y-4">
        <div class="text-center p-2 bg-gray-50 rounded-lg border border-gray-100">
          <div class="text-sm text-gray-500 uppercase font-bold"><%= date.strftime("%a") %></div>
          <div class="text-xl font-bold <%= date == Date.today ? 'text-primary-accent' : 'text-gray-800' %>"><%= date.day %></div>
        </div>

        <% %w[breakfast lunch dinner snack].each do |meal_type| %>
          <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-3 min-h-[120px] flex flex-col relative group hover:border-primary-accent/30 transition-colors">
            <div class="text-xs text-gray-400 uppercase font-bold mb-2 flex justify-between">
              <%= meal_type %>
              <button type="button" 
                      onclick="document.getElementById('add-meal-modal-<%= date %>-<%= meal_type %>').classList.remove('hidden')"
                      class="opacity-0 group-hover:opacity-100 text-primary-accent hover:text-primary-accent-dark transition-opacity">
                + Add
              </button>
            </div>

            <% if @planned_meals[date] && @planned_meals[date][meal_type] %>
              <% @planned_meals[date][meal_type].each do |plan| %>
                <div class="bg-green-50 border border-green-100 rounded-lg p-2 mb-2 last:mb-0 group/item relative">
                  <div class="font-medium text-sm text-gray-800 line-clamp-2"><%= plan.recipe.name %></div>
                  <% if plan.description.present? %>
                    <div class="text-xs text-gray-500 mt-1 line-clamp-1"><%= plan.description %></div>
                  <% end %>
                  
                  <%= button_to meal_plan_path(plan), method: :delete, class: "absolute -top-1 -right-1 bg-white rounded-full p-0.5 shadow-sm border border-gray-200 opacity-0 group-hover/item:opacity-100 transition-opacity text-red-500 hover:text-red-700" do %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <div class="flex-1 flex items-center justify-center">
                <button type="button" 
                        onclick="document.getElementById('add-meal-modal-<%= date %>-<%= meal_type %>').classList.remove('hidden')"
                        class="text-gray-300 hover:text-primary-accent transition-colors">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </button>
              </div>
            <% end %>

          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<!-- Modals moved outside the grid to avoid stacking context issues -->
<% (@start_date..@end_date).each do |date| %>
  <% %w[breakfast lunch dinner snack].each do |meal_type| %>
    <div id="add-meal-modal-<%= date %>-<%= meal_type %>" class="hidden fixed inset-0 z-[60] overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
      <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" onclick="document.getElementById('add-meal-modal-<%= date %>-<%= meal_type %>').classList.add('hidden')"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full relative z-10">
          <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
            <h3 class="text-lg leading-6 font-medium text-gray-900 mb-4" id="modal-title">
              Add <%= meal_type.capitalize %> for <%= date.strftime("%A, %b %d") %>
            </h3>
            <%= form_with model: MealPlan.new, url: meal_plans_path, local: true do |f| %>
              <%= f.hidden_field :date, value: date %>
              <%= f.hidden_field :meal_type, value: meal_type %>
              
              <div class="mb-4">
                <%= f.label :recipe_id, "Recipe", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.collection_select :recipe_id, @recipes, :id, :name, { prompt: "Select a recipe..." }, { class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-accent focus:border-transparent" } %>
              </div>
              
              <div class="mb-4">
                <%= f.label :description, "Notes (optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
                <%= f.text_area :description, rows: 2, placeholder: "Add any notes about this meal...", class: "w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-accent focus:border-transparent" %>
              </div>
              
              <div class="mt-5 sm:mt-6 flex justify-end space-x-3">
                <button type="button" onclick="document.getElementById('add-meal-modal-<%= date %>-<%= meal_type %>').classList.add('hidden')" class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-accent">
                  Cancel
                </button>
                <%= f.submit "Add Meal", class: "inline-flex justify-center w-full rounded-md border border-transparent shadow-sm px-4 py-2 bg-primary-accent text-base font-medium text-white hover:bg-primary-accent-dark focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-accent sm:text-sm sm:w-auto" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
