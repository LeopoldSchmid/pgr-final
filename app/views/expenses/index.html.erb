<% content_for :head do %>
  <%= javascript_include_tag "expense_app", type: "module", "data-turbo-track": "reload" %>
<% end %>

<div
  data-controller="expense-app"
  data-expense-app-snapshot-url-value="<%= api_trip_expense_snapshot_path(@trip) %>"
  data-expense-app-mutation-url-value="<%= api_trip_expense_client_mutations_path(@trip) %>"
  data-expense-app-trip-people-url-value="<%= api_trip_trip_people_path(@trip) %>"
  data-expense-app-split-groups-url-value="<%= api_trip_split_groups_path(@trip) %>"
  data-expense-app-current-user-id-value="<%= Current.user.id %>"
  data-expense-app-initial-panel-value="<%= params[:panel].presence_in(%w[entry people summary activity]) || "entry" %>">
  <section class="mx-auto flex w-full max-w-6xl flex-col gap-4 px-4 py-4 md:px-6">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
      <div class="text-sm font-medium text-slate-500">Loading expenses</div>
      <div class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-sm font-medium text-slate-700">
        Loading expense app
      </div>
    </div>

    <noscript>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-800">
        JavaScript is required for the new expense app.
      </div>
    </noscript>

    <div class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm">
      <p class="text-sm text-slate-500">Loading the modern expense experience...</p>
      <% if @expenses.any? %>
        <div class="mt-3 space-y-2">
          <% @expenses.limit(5).each do |expense| %>
            <div class="flex items-center justify-between gap-3 text-sm">
              <span class="truncate font-medium text-slate-900"><%= expense.description %></span>
              <span class="shrink-0 text-slate-600"><%= expense.formatted_amount %></span>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </section>
</div>
