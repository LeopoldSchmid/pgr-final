#!/usr/bin/env ruby
unless ENV["PLANGOREMINISCE_RUBY_REEXEC"]
  if system("command -v mise >/dev/null 2>&1", out: File::NULL, err: File::NULL)
    ENV["PLANGOREMINISCE_RUBY_REEXEC"] = "1"
    exec("mise", "exec", "--", "ruby", __FILE__, *ARGV)
  end
end

# frozen_string_literal: true

#
# This file was generated by Bundler.
#
# The application 'kamal' is installed as part of a gem, and
# this file is here to facilitate running it.
#

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)

require "rubygems"
require "bundler/setup"

load Gem.bin_path("kamal", "kamal")
